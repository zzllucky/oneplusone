# 复制为 .env 后按需修改；切勿把真实密钥提交到仓库

# JWT 密钥（生产环境 MUST 使用足够长的随机串，建议 ≥ 32 字节）
JWT_SECRET=change-me-to-a-long-random-string

# SQLite 数据文件（相对当前工作目录）
DB_PATH=data/app.db

# 发音代理（服务端代理第三方公共发音接口）
PRONOUNCE_UPSTREAM_URL=https://dict.youdao.com/dictvoice?audio={word}&type=1
PRONOUNCE_TIMEOUT_SECONDS=2
PRONOUNCE_CACHE_DIR=data/cache/pronounce

# 每日目标默认值 / 时区 / 前端静态目录
DAILY_GOAL_DEFAULT=20
TIMEZONE=Asia/Shanghai
STATIC_DIR=../frontend/dist
