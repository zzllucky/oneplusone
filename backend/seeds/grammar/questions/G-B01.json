        { "key": "B", "text": "is smelling", "distractor": "smell 作系动词不用进行时" },
        { "key": "C", "text": "smell", "distractor": "主语是第三人称单数" },
        { "key": "D", "text": "smelling", "distractor": "句子缺少谓语" }
      ],
      "explanation": "smell 是系动词 + 形容词 sour。",
      "error_tag": "G-B01"
    },
    {
      "id": "G-B01-L3-01",
      "level": "L3",
      "stem": "下面哪一句是错误的？",
