    {
      "id": "G-V03-L3-01",
      "level": "L3",
      "stem": "下面哪一句是错误的？",
      "options": [
        { "key": "A", "text": "The trees should be watered often.", "distractor": "正确" },
        { "key": "B", "text": "The bike can be repaired here.", "distractor": "正确" },
        { "key": "C", "text": "The room must is cleaned at once.", "answer": true },
        { "key": "D", "text": "The question may be answered later.", "distractor": "正确" }
      ],
      "explanation": "情态动词后只能用原形 be：must be cleaned。",
      "error_tag": "G-V03"
    },
    {
      "id": "G-V03-L3-02",
      "level": "L3",
      "stem": "Young trees ____ (look after) well, or they will die.",
