        { "key": "D", "text": "turning", "distractor": "被动不用 -ing" }
      ],
      "explanation": "must + be + turned off。",
      "error_tag": "G-V03"
    },
    {
      "id": "G-V03-L1-02",
      "level": "L1",
      "stem": "Water can ____ (use) again and again.",
