        { "key": "B", "text": "be used", "answer": true },
        { "key": "C", "text": "be use", "distractor": "be 后要接过去分词 used" },
        { "key": "D", "text": "used", "distractor": "缺少 be 动词" }
      ],
      "explanation": "can + be + used。",
      "error_tag": "G-V03"
    },
    {
      "id": "G-V03-L2-01",
      "level": "L2",
      "stem": "The work ____ (finish) by five o'clock. We must hurry.",
