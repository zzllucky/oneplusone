        { "key": "B", "text": "must be finished", "answer": true },
        { "key": "C", "text": "must is finished", "distractor": "情态动词后不能接 is" },
        { "key": "D", "text": "must been finished", "distractor": "情态动词后不能接 been" }
      ],
      "explanation": "must + be + finished。",
      "error_tag": "G-V03"
    },
    {
