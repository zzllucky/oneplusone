  "questions": [
    {
      "id": "G-B05-L1-01",
      "level": "L1",
      "stem": "— How long can I ____ the magazine? — For two weeks.",
      "options": [
        { "key": "A", "text": "borrow", "distractor": "borrow 是短暂动作，不能接 how long" },
        { "key": "B", "text": "keep", "answer": true },
        { "key": "C", "text": "lend", "distractor": "lend 是借出，且不能接时间段" },
        { "key": "D", "text": "buy", "distractor": "与答语“两周”不符" }
      ],
      "explanation": "与 how long / for + 时间段连用 → keep。",
      "error_tag": "G-B05"
    },
    {
      "id": "G-B05-L1-02",
