  "questions": [
    {
      "id": "G-T03-L1-01",
      "level": "L1",
      "stem": "He ____ fish, but he likes meat.",
      "options": [
        { "key": "A", "text": "don't like", "distractor": "he 是三单，要用 doesn't" },
        { "key": "B", "text": "doesn't like", "answer": true },
        { "key": "C", "text": "isn't like", "distractor": "like 是实义动词，否定时用 doesn't，不用 isn't" },
        { "key": "D", "text": "not like", "distractor": "缺少助动词" }
      ],
      "explanation": "三单主语否定时用 doesn't + 动词原形 like。",
      "error_tag": "G-T03"
    },
    {
      "id": "G-T03-L1-02",
