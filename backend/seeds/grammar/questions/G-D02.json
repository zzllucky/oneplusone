  "questions": [
    {
      "id": "G-D02-L1-01",
      "level": "L1",
      "stem": "— How do you go to school? — I ____ go there on foot.",
      "options": [
        { "key": "A", "text": "usually", "answer": true },
        { "key": "B", "text": "am usually", "distractor": "go 是实义动词，前面不加 be" },
        { "key": "C", "text": "usually am", "distractor": "结构错误" },
        { "key": "D", "text": "do usually", "distractor": "一般现在时不需要助动词" }
      ],
      "explanation": "频度副词放实义动词前：usually go。",
      "error_tag": "G-D02"
    },
    {
      "id": "G-D02-L1-02",
