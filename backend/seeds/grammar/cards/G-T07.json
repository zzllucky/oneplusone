        { "base": "eat", "past": "ate", "participle": "eaten", "zh": "吃" },
        { "base": "write", "past": "wrote", "participle": "written", "zh": "写" },
        { "base": "come", "past": "came", "participle": "come", "zh": "来" },
        { "base": "give", "past": "gave", "participle": "given", "zh": "给" }
      ],
      "anchor": { "en": "They went to the museum last Sunday.", "zh": "他们上周日去了博物馆。" }
